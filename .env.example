# ── Backend ──────────────────────────────────────────────────────────────────
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=Cluster0

# Secreto para firmar los JWT. En producción DEBE ser un valor aleatorio largo.
JWT_SECRET=cambiar-esto-en-produccion

# Duración del token (por defecto 8h)
JWT_EXPIRA=8h

# Contraseña del usuario administrador (por defecto 123456 si no se define)
ADMIN_PASSWORD=cambiar-esto-en-produccion

# ── Frontend (variable de entorno en Netlify) ─────────────────────────────────
# URL pública del backend desplegado en Railway
NEXT_PUBLIC_API_URL=https://tu-app.up.railway.app
