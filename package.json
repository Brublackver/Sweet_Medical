{
  "name": "sweet-medical",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"node --watch backend/server.js\" \"next dev frontend -p 3001\"",
    "dev:front": "next dev frontend -p 3001",
    "dev:back": "node --watch backend/server.js",
    "start": "node backend/server.js",
    "build": "next build frontend",
    "preview": "next start frontend -p 3001",
    "lint": "cd frontend && eslint src",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.17.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "mongoose": "^8.15.0",
    "next": "^15.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@jest/globals": "^30.3.0",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "jest": "^30.3.0",
    "prettier": "^3.0.0"
  }
}
